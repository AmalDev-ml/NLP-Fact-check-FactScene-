# FactSense Environment Configuration
# Copy this file to .env and fill in any keys you have available.
# Note: FactSense runs 100% locally out-of-the-box using DuckDuckGo search + DeBERTa NLI + local sentence embeddings
# even if all API keys are left blank!

# ── LLM Reasoning & Structured Claim Extraction (Recommended) ───────────────────
# FactSense automatically detects configured LLMs: Gemini, Groq, OpenAI, or Ollama.
# If no LLM key is set, the system runs in Degraded Mode (heuristic extraction, confidence capped at 60%).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Groq Cloud (Alternative fast LLM provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI (Alternative LLM provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local Ollama (Self-hosted offline LLM)
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# ── Live Web Search APIs ────────────────────────────────────────────────────────
# Default search uses DuckDuckGo (ddgs) and Wikipedia REST API with zero API keys required.
# If Serper (Google Search) or Tavily keys are provided, they are prioritized for live search.
SERPER_API_KEY=
TAVILY_API_KEY=
GOOGLE_FACTCHECK_API_KEY=

# ── Performance & Verification Flags ────────────────────────────────────────────
# Set to true to enable secondary DeBERTa NLI cross-checking (lazy loaded on demand).
# Default false for sub-10 second verification speed on CPU.
USE_DEBERTA_CROSSCHECK=false

# Neural NLI Model Selection (used only if USE_DEBERTA_CROSSCHECK=true)
FACTSENSE_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall

